# ── Backend Configuration ───────────────────────────────────────────────────

# Comma-separated Gemini API keys from https://aistudio.google.com
# At least 2 keys required. Assigned in order: key_1, key_2, ...
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# SQLite database file path (inside Docker volume)
DATABASE_URL=sqlite+aiosqlite:////data/app.db

# Comma-separated CORS allowed origins (add your frontend URL here when deployed)
ALLOWED_ORIGINS=http://localhost:3000

# Enables the X-Simulate-Failure header on POST /chat (must be true on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Port for backend
PORT=8000

# ── Frontend Configuration ──────────────────────────────────────────────────

# Backend base URL accessed by the frontend (for local dev: http://localhost:8000)
VITE_API_URL=http://localhost:8000
